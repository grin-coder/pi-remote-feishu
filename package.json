{
  "name": "pi-remote-feishu",
  "version": "0.1.4",
  "description": "Remote control Pi Agent via Feishu (飞书) chat: WebSocket bridge, cards, attachments and file sending.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grin-coder/pi-remote-feishu.git"
  },
  "homepage": "https://github.com/grin-coder/pi-remote-feishu",
  "bugs": {
    "url": "https://github.com/grin-coder/pi-remote-feishu/issues"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "feishu",
    "lark",
    "bot",
    "chat-bridge",
    "websocket"
  ],
  "bin": {
    "pi-remote-feishu": "dist/bin/pi-remote-feishu.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extension": {
      "types": "./dist/extensions/index.d.ts",
      "import": "./dist/extensions/index.js"
    }
  },
  "pi": {
    "extensions": [
      "./dist/extensions/index.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "dist",
    "skills",
    "ARCHITECTURE.md",
    "ARCHITECTURE.zh-CN.md",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run clean && npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@larksuiteoapi/node-sdk": "1.66.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
